# ---------------------------------------------------------------------------
# Stallion Horse Riding Academy — Apache configuration
# ---------------------------------------------------------------------------

# Never serve the config or include folder directly
RedirectMatch 404 (?i)/inc/.*\.php$
RedirectMatch 404 (?i)/\.(git|env|htaccess|htpasswd)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. The includes folder is off limits, with or without an extension,
  #    so /inc/config cannot sneak past rule 4 below.
  RewriteRule ^inc(/|$) - [F,L]

  # 2. Drop a trailing slash on non-directories: /customers/ -> /customers
  #    The target is built from REQUEST_URI so it stays a URL path — a relative
  #    substitution here can expand to the filesystem path instead.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.*[^/])/+$
  RewriteRule ^ %1 [R=301,L,NE]

  # 3. Canonical form: /customers.php -> /customers
  #    GET only. Redirecting a POST would turn it into a GET and throw away
  #    the form data, which would break every form in the app.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s([^?\s]*)\.php([?\s]) [NC]
  RewriteRule ^ %1 [R=301,L,NE]

  # 4. Serve /customers from customers.php (works in a subfolder too).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# Sensible defaults
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# No directory listings, and no content negotiation guessing at
# extensions — that conflicts with the rewrite rules above.
Options -Indexes -MultiViews

DirectoryIndex index.php

# Cache static assets, never cache PHP output
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml       "access plus 30 days"
  ExpiresByType image/png           "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Upload limits. php_value is only valid under mod_php — guarded so the site
# does not 500 on PHP-FPM/FastCGI hosts, where these belong in php.ini instead.
<IfModule mod_php.c>
  php_value post_max_size 8M
  php_value upload_max_filesize 8M
</IfModule>
<IfModule mod_php7.c>
  php_value post_max_size 8M
  php_value upload_max_filesize 8M
</IfModule>
